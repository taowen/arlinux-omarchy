#!/bin/bash
set -euo pipefail
case ${1:-} in
  update)
    (( $# == 1 )) || { echo 'usage: omarchy-pacman update' >&2; exit 2; }
    ;;
  install)
    (( $# > 1 )) || { echo 'usage: omarchy-pacman install PACKAGE...' >&2; exit 2; }
    for package in "${@:2}"; do
      [[ $package =~ ^[a-zA-Z0-9@._+-]+$ ]] || { echo "invalid package name: $package" >&2; exit 2; }
    done
    ;;
  *) echo 'usage: omarchy-pacman {update|install PACKAGE...}' >&2; exit 2 ;;
esac
printf '%s\n' "$*" | socat -t 3600 - "ABSTRACT-CONNECT:arlinux-pacman-$(id -u)" | \
  awk '/^Package transaction exited [0-9]+$/ { status=$4; seen=1 }
       { print; fflush() }
       END { exit seen ? status : 1 }'
