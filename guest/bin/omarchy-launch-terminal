#!/bin/bash
set -e
args=()
while (( $# )); do
  case $1 in
    --working-directory=*) cd "${1#*=}"; shift ;;
    --working-directory) cd "$2"; shift 2 ;;
    -e) args+=("$@"); break ;;
    *) args+=("$1"); shift ;;
  esac
done
if (( ${#args[@]} == 0 )); then args=(-e "$SHELL" -i); fi
exec foot --app-id=org.omarchy.terminal "${args[@]}"
