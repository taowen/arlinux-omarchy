#!/bin/bash
set -e
for argument in "$@"; do
  if [[ $argument == --private ]]; then
    echo 'Private browsing is not provided by the Android WebView browser.' >&2
    exit 2
  fi
done
browser=$(xdg-settings get default-web-browser 2>/dev/null || true)
browser=${browser:-arlinux-browser.desktop}
for directory in "$HOME/.local/share/applications" "$BIONICX_ROOTFS/usr/share/applications"; do
  if [[ -f $directory/$browser ]]; then
    exec gio launch "$directory/$browser" "$@"
  fi
done
echo "Browser desktop entry not found: $browser" >&2
exit 1
