{
  "version": 1,
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "omarchy.clock",
    "layout": {
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        }
      ],
      "center": [
        {
          "id": "omarchy.clock",
          "format": "dddd HH:mm"
        }
      ],
      "right": [
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.tray"
        }
      ]
    }
  },
  "plugins": [],
  "disabledPlugins": [
    "omarchy.idle",
    "omarchy.lock",
    "omarchy.battery",
    "omarchy.media",
    "omarchy.polkit"
  ]
}
