{
  "apps": {
    "icon": "󰀻",
    "label": "Apps",
    "aliases": [
      "app",
      "applications"
    ],
    "provider": "apps"
  },
  "learn": {
    "icon": "󰧑",
    "label": "Learn"
  },
  "learn.keybindings": {
    "icon": "",
    "label": "Keybindings",
    "action": "omarchy-menu-keybindings"
  },
  "learn.omarchy": {
    "icon": "",
    "label": "Omarchy",
    "action": "omarchy-launch-webapp 'https://omarchy.org/manual/'"
  },
  "learn.hyprland": {
    "icon": "",
    "label": "Hyprland",
    "action": "omarchy-launch-webapp 'https://wiki.hypr.land/'"
  },
  "learn.arch": {
    "icon": "󰣇",
    "label": "Arch",
    "action": "omarchy-launch-webapp 'https://wiki.archlinux.org/title/Main_page'"
  },
  "learn.bash": {
    "icon": "󱆃",
    "label": "Bash",
    "action": "omarchy-launch-webapp 'https://devhints.io/bash'"
  },
  "style": {
    "icon": "",
    "label": "Style"
  },
  "style.theme": {
    "icon": "󰸌",
    "label": "Theme",
    "aliases": [
      "theme",
      "themes"
    ],
    "action": "theme=$(omarchy-theme-switcher); [[ -n $theme ]] && omarchy-theme-set \"$theme\""
  },
  "style.background": {
    "icon": "",
    "label": "Background",
    "aliases": [
      "background",
      "wallpaper"
    ],
    "action": "background=$(omarchy-theme-bg-switcher); [[ -n $background ]] && omarchy-theme-bg-set \"$background\""
  },
  "style.font": {
    "icon": "",
    "label": "Font",
    "provider": "fonts"
  },
  "style.bar": {
    "icon": "󰍜",
    "label": "Menu Bar"
  },
  "style.bar.position": {
    "icon": "",
    "label": "Position"
  },
  "style.bar.transparency": {
    "icon": "󰂵",
    "label": "Transparency",
    "action": "omarchy-bar transparent toggle"
  },
  "style.bar.position.top": {
    "icon": "󰁝",
    "label": "Top",
    "action": "omarchy-bar position top"
  },
  "style.bar.position.bottom": {
    "icon": "󰁅",
    "label": "Bottom",
    "action": "omarchy-bar position bottom"
  },
  "style.bar.position.left": {
    "icon": "󰁍",
    "label": "Left",
    "action": "omarchy-bar position left"
  },
  "style.bar.position.right": {
    "icon": "󰁔",
    "label": "Right",
    "action": "omarchy-bar position right"
  },
  "style.hyprland": {
    "icon": "",
    "label": "Hyprland",
    "action": "omarchy-launch-config-editor \"$HOME/.config/hypr/looknfeel.lua\""
  },
  "setup": {
    "icon": "",
    "label": "Setup",
    "aliases": [
      "settings"
    ]
  },
  "setup.keybindings": {
    "icon": "",
    "label": "Keybindings",
    "when": "[[ -f ~/.config/hypr/bindings.lua ]]",
    "action": "omarchy-launch-config-editor \"$HOME/.config/hypr/bindings.lua\""
  },
  "setup.input": {
    "icon": "",
    "label": "Input",
    "when": "[[ -f ~/.config/hypr/input.lua ]]",
    "action": "omarchy-launch-config-editor \"$HOME/.config/hypr/input.lua\""
  },
  "files": {
    "icon": "",
    "label": "Files",
    "action": "thunar \"$HOME\""
  },
  "browser": {
    "icon": "",
    "label": "Browser",
    "action": "omarchy-launch-browser https://omarchy.org/"
  },
  "setup.desktop": {
    "icon": "",
    "label": "Desktop",
    "action": "omarchy-launch-editor \"$HOME/.config/omarchy/shell.json\""
  },
  "packages": {
    "icon": "󰏖",
    "label": "Packages"
  },
  "packages.update": {
    "icon": "",
    "label": "Update Arch packages",
    "action": "omarchy-launch-terminal -e bash -c 'BIONICX_VIRTUAL_ROOT=1 pacman -Syu; read -rp \"Press Enter to close\"'"
  },
  "packages.terminal": {
    "icon": "",
    "label": "Open terminal",
    "action": "omarchy-launch-terminal"
  }
}
